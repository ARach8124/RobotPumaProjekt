<?xml version="1.0"?>
<robot name="prosty_robot">

  <material name="niebieski">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="bialy">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.4 0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="niebieski"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <link name="ramie_link">
    <visual>
      <geometry><cylinder length="0.5" radius="0.04"/></geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="bialy"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.5" radius="0.04"/></geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_ramie" type="revolute">
    <parent link="base_link"/>
    <child link="ramie_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>