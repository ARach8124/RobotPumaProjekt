<?xml version="1.0"?>
<robot name="prosty_robot">

  <material name="niebieski">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="bialy">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.4 0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="niebieski"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_ramie_joint" type="revolute">
    <parent link="base_link"/>
    <child link="ramie_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <calibration rising="0.0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="30" velocity="1.0" lower="-1.5" upper="1.5" />
    <safety_controller k_velocity="10" k_position="15" soft_lower_limit="-1.3" soft_upper_limit="1.3" />
  </joint>

  <link name="ramie_link">
    <visual>
      <geometry><box size="0.13 0.13 1"/></geometry>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <material name="bialy"/>
    </visual>
    <collision>
      <geometry><box size="0.13 0.13 1"/></geometry>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="ramie_ramie2_joint" type="revolute">
    <parent link="ramie_link"/>
    <child link="ramie2_link"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <calibration rising="0.0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="30" velocity="1.0" lower="-1.5" upper="1.5" />
    <safety_controller k_velocity="10" k_position="15" soft_lower_limit="-1.3" soft_upper_limit="1.3" />
  </joint>

  <link name="ramie2_link">
    <visual>
      <geometry><box size="0.13 0.13 1"/></geometry>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <material name="bialy"/>
    </visual>
    <collision>
      <geometry><box size="0.13 0.13 1"/></geometry>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

</robot>